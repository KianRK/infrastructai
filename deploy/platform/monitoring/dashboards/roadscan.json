          "expr": "sum by (envoy_cluster_name) (envoy_cluster_upstream_rq_active{envoy_cluster_name=~\"httproute/roadscan/.*\"})",
          "legendFormat": "{{envoy_cluster_name}}",
          "refId": "A"
        }
