        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(ray_serve_num_http_requests_total{application=\"roadscan\",status_code=~\"5..\"}[5m])) or vector(0)",
          "refId": "A",
          "instant": false
