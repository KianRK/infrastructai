{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Axis-aligned box in coordinates relative to the image size (0..1).\n\nRelative coordinates let the frontend draw boxes at any display size\nwithout knowing how the image was resized for inference.",
      "properties": {
        "x_min": {
          "maximum": 1,
          "minimum": 0,
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y Max",
          "type": "number"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "DamageClass": {
      "enum": [
        "D00",
        "D10",
        "D20",
        "D40"
      ],
      "title": "DamageClass",
      "type": "string"
    },
    "Detection": {
      "additionalProperties": false,
      "properties": {
        "damage_class": {
          "$ref": "#/$defs/DamageClass"
        },
        "label": {
          "description": "Human-readable class name, e.g. 'pothole'.",
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "box": {
          "$ref": "#/$defs/BoundingBox"
        }
      },
      "required": [
        "damage_class",
        "label",
        "confidence",
        "box"
      ],
      "title": "Detection",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "description": "What is usually done about one detected damage type.\n\nThe texts come verbatim from the curated reference notes, not from the language model.",
      "properties": {
        "damage_class": {
          "$ref": "#/$defs/DamageClass"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "moderate",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "needs_verification": {
          "description": "The detector is unsure about this damage type; check it on site.",
          "title": "Needs Verification",
          "type": "boolean"
        },
        "usual_repair": {
          "title": "Usual Repair",
          "type": "string"
        },
        "typical_causes": {
          "title": "Typical Causes",
          "type": "string"
        }
      },
      "required": [
        "damage_class",
        "label",
        "severity",
        "needs_verification",
        "usual_repair",
        "typical_causes"
      ],
      "title": "Recommendation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "detections": {
      "items": {
        "$ref": "#/$defs/Detection"
      },
      "title": "Detections",
      "type": "array"
    },
    "description": {
      "description": "Short summary grounded in the detections.",
      "title": "Description",
      "type": "string"
    },
    "recommendations": {
      "description": "One entry per detected damage type, most severe first.",
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "disclaimer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Limits of the assessment; null when nothing was detected.",
      "title": "Disclaimer"
    },
    "description_source": {
      "enum": [
        "llm",
        "template",
        "no_damage"
      ],
      "title": "Description Source",
      "type": "string"
    },
    "image_width": {
      "exclusiveMinimum": 0,
      "title": "Image Width",
      "type": "integer"
    },
    "image_height": {
      "exclusiveMinimum": 0,
      "title": "Image Height",
      "type": "integer"
    },
    "detector_version": {
      "title": "Detector Version",
      "type": "string"
    },
    "llm_model": {
      "title": "Llm Model",
      "type": "string"
    }
  },
  "required": [
    "detections",
    "description",
    "recommendations",
    "disclaimer",
    "description_source",
    "image_width",
    "image_height",
    "detector_version",
    "llm_model"
  ],
  "title": "AnalysisResponse",
  "type": "object"
}
